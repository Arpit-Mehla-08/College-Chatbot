# Browser-accessible URL of the deployed backend (Render), no trailing slash.
# Used directly by the chat request to bypass the Next.js rewrite proxy
# (avoids proxy timeouts on long LLM calls).
NEXT_PUBLIC_BACKEND_URL=https://your-backend.onrender.com

# Same backend URL - used by the Next.js rewrite (next.config.js) for the
# remaining /api/* routes (conversations, logs).
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
